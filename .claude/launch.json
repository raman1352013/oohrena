{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-memory",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api:memory"],
      "env": { "CORS_ORIGINS": "http://localhost:8080,http://127.0.0.1:8080" },
      "port": 4000
