# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# MongoDB must be a replica set (Atlas clusters are) — registration and bookings use transactions.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/oohrena?retryWrites=true&w=majority
# Frontend origins allowed to send cookie-authenticated requests.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
SESSION_TTL_HOURS=12
BCRYPT_COST=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Set when running behind a reverse proxy / load balancer (number of hops).
TRUST_PROXY=0
# 32 random bytes, base64 (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Encrypts bank account numbers and KYC documents at rest. Required in staging/production; keep it in the secret store.
DATA_ENCRYPTION_KEY=
# Private folder for uploads (KYC documents, site photos). Never serve it statically.
UPLOAD_DIR=./uploads
# Default platform margin (%) used to suggest the client-facing price when approving a listing.
DEFAULT_MARGIN_PCT=20
# Used only by `npm run seed` to create one test account per role on non-production databases.
SEED_PASSWORD=
# Public web origin used in emailed links (reset password, invites). Defaults to the first CORS origin.
PUBLIC_WEB_URL=http://localhost:8080
# Transactional email over SMTP (required in production), e.g. smtps://USER:PASS@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=OOHRENA <no-reply@oohrena.com>
# Require 2FA enrolment for admin/finance logins ("true"/"false").
REQUIRE_2FA_PRIVILEGED=false
# Private S3-compatible bucket for uploads (AWS S3 / Cloudflare R2). Unset = local UPLOAD_DIR.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Shared rate-limit store when running more than one API instance.
REDIS_URL=
