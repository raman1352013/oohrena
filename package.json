{
  "name": "oohrena",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev -w @oohrena/web",
    "dev:api": "npm run dev -w @oohrena/api",
    "dev:api:memory": "npm run dev:memory -w @oohrena/api",
    "seed:api": "npm run seed -w @oohrena/api",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w @oohrena/api",
    "test:web": "npm run test -w @oohrena/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": { "node": ">=22" }
}
